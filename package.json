{
  "name": "bebetrack",
  "private": true,
  "type": "module",
  "description": "Private baby tracker for two phones, end-to-end encrypted with a shared passphrase.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "TZ=America/New_York node --test \"test/core/**/*.test.js\" \"test/data/**/*.test.js\"",
    "test:emulator": "firebase emulators:exec --only firestore --project demo-bebetrack \"node --test --test-concurrency=1 'test/emulator/**/*.test.js'\"",
    "emulator": "firebase emulators:start --only firestore --project demo-bebetrack",
    "serve": "python3 -m http.server 5173 --directory app"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.1.0",
    "firebase-tools": "15.34.2"
  }
}
